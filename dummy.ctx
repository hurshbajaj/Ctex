@use ~std; // packages
@import "lib.ctx"; // project files, from project root
@from "/lib" "*.ctx" ; // specialized import 

@type_cast ~string {
    <type: func(u8)> {
        ..
    };

    <type: func(bool)> {
        ..
    };
};

$ register_initialization <type: INIT> {
	$ %ctx_ffi <type: enum> {..};

    $ %ictx_F <asg> <type: std::IO> std::IO::protobuf; // input ctx format
    $ %ictx_T <asg> struct { // .. type
        <some_enum*> some_input_field,
    };

    $ %octx_F <type: std::IO> <asg> std::IO::protobuf;
    $ %octx_T <type: struct> <asg> {..}; 

    %core_signature -> "core14367";

    //compiler directive
    @defer ~collapse { 
        %ictx_F; 
        %ictx_T; 
        %octx_F; 
        %octx_T;
        %core_signature;
    } ;
};

$ main <type: ENTRY> {
    // comments exist!
    /* cool! */

    $ my_new_variable <type: u8> <asg> 4;
    my_new_variable -> 7;

    %octx.some_key -> ..;

    $ my_struct <asg> <trait: [my_trait, my_second_trait]> struct {
        property: u64,
    };
    $ my_trait <type: t_fn(nul)> <asg> {
        return %self.property;
    };
    $ my_second_trait <type: t_fn(nul)> <asg> {
        return %self.property;
    };

    $ my_trait_unclaimed <type: t_fn(nul)>;

    $ my_object <type: my_struct*> <mutable> <asg> {
        property: 10,425 ,
    };

    $ %register1 <type: u8> <mutable> <asg> 44;
    $ %register2 <type: u8> <mutable> <asg> 16;

    %argv ~> [my_func().conv().check()]; //shorthand for &[..]
    std::printf();

    std::printf (conv_int(14, std::data_types::string).check() + 2); //shorthand, automatically sets argv

    $ my_enum <type: enum> -> {
        | SUCCESS((%argv[0])?), 
        | FAILURE,
    };

    $ my_array <type: array(u8; 2)> -> [1, 1];
    $ my_vector <type: vec(u8)> -> 1::7::[];

    $ my_type <type: type> array(u8; 2);
    $ my_array <type: my_type*> <asg> [2, 2];

    $ second_arr <type: tuple(u8; 3)> <asg> (1, 2, 3);
    
    $ my_ptr <type: usize> <asg> &my_object; 

    if my_arr == second_arr {..};

    $ my_enum_value <type: my_enum(string)*> <asg> my_enum::FAILURE;
    $ unwrapp_example <type: string> <asg> my_enum_value.unwrap_to(my_enum(string)::SUCCESS).check();
    $ (x, y) <type: tuple(u8; 2)> <asg> some_random_tuple_value;

    match my_enum_value {
        SUCCESS(_string) => {},
        FAILURE => {}
    };

    match .. {
        (x, y) => {},
    };

    match .. {
        hl::ll => {},
        ? => {}
    };

    <type: scope> { //or <type:scope> 
        ..
    };

    //"type:" may be ommitted from flags elsewhere as well

    ~ %register1;
};

$ my_func <asg> <type: func(Result(u8))> { 
    //without specifying the type in front of enum, it uses what's already there
    return std::Result::Ok(%register1 + %register2); 
};

/*
    A special command,
    ctexc eval file.ctx --context

    returns an object, from the host language's type system, with all the variables marked by <exposed>

    The normal command to run would be,
    ctexc exec file.ctx --context
*/

/*
    Reserved Regsters,
    ictx_T; ictx_F; octx_T; octx_F; octx; (expect to be declared and populated before running ENTRY)
    ctx;
    argv; 
    self;
	core_signature;
*/
/*
    Generic Type (?) assumes the type of whatever register / variable in question
*/
